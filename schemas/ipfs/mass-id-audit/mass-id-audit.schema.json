                    },
                    "title": "Field Change Categories",
                    "description": "One or more distinct approved categories explaining this field",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "image_update",
                        "reference_update"
                      ]
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\uD800-\\uDFFF]*$"
                      }
                    ],
                    "title": "Revision Reason",
                    "description": "Approved human explanation, at most 500 UTF-16 units with well-formed Unicode; preserved verbatim without trimming or normalization",
                    "examples": [
                      "Use the approved image document.",
                      "Correct the metadata references."
                    ]
                  },
                  "references": {
                    "title": "Field Change Supporting References",
                    "description": "Distinct public evidence references when real supporting information exists; omit rather than fabricate evidence",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "https://example.com/evidence/correction"
                      ]
                    ],
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
                          "title": "IPFS URI",
                          "description": "InterPlanetary File System URI pointing to distributed content",
                          "examples": [
                            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
                          ]
                        },
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "maxLength": 4096,
                              "format": "uri",
                              "title": "External URL",
                              "description": "URL pointing to external resources",
                              "examples": [
                                "https://registry.example.com/",
                                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/[^/?#\\s]+(?:[/?#][\\s\\S]*)?$"
                            }
                          ]
                        }
                      ],
                      "title": "Revision Supporting Reference",
                      "description": "Public supporting evidence actually available for this field change, expressed as a valid IPFS document URI or HTTP(S) URL",
                      "examples": [
                        "https://example.com/evidence/correction"
                      ]
                    }
                  }
                },
                "required": [
                  "path",
                  "categories",
                  "reason"
                ],
                "additionalProperties": false,
                "title": "Declared Revision Change",
                "description": "Field-level explanation without an operation when predecessor comparison is unavailable; no copied old or new values"
              },
              "title": "Declared Field Changes",
              "description": "Distinct declared field paths and approved explanations without an invented operation or old value"
            }
          },
          "required": [
            "previous_uri",
            "reason",
            "comparison",
            "changes"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Metadata Revision",
      "description": "Common revision block required by new update publication paths and absent on initial publication; producer context and independent readback establish publication and comparison facts"
    },
    "viewer_reference": {
      "type": "object",
      "properties": {
        "ipfs_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Viewer IPFS URI",
          "description": "IPFS URI of the metadata viewer dApp build",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        }
      },
      "required": [
        "ipfs_uri"
      ],
      "additionalProperties": false,
      "title": "Metadata Viewer Reference",
      "description": "Immutable reference to the metadata viewer dApp build. The IPFS CID itself is the integrity proof: tampered content resolves to a different CID"
    },
    "environment": {
      "type": "object",
      "properties": {
        "blockchain_network": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet"
          ],
          "title": "Blockchain Network",
          "description": "Blockchain network where this record is deployed"
        },
        "deployment": {
          "type": "string",
          "enum": [
            "production",
            "development",
            "testing"
          ],
          "title": "Deployment Environment",
          "description": "System environment where this record was generated"
        },
        "data_set_name": {
          "type": "string",
          "enum": [
            "TEST",
            "PROD"
          ],
          "title": "Data Set Name",
          "description": "Name of the data set for this record"
        }
      },
      "required": [
        "blockchain_network",
        "deployment",
        "data_set_name"
      ],
      "additionalProperties": false,
      "title": "Record Environment",
      "description": "Environment information for the record"
    },
    "data": {
      "type": "object",
      "properties": {
        "methodology": {
          "type": "object",
          "properties": {
            "external_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "title": "Methodology External ID",
              "description": "Unique identifier for the methodology",
              "examples": [
                "00000000-0000-4000-8000-000000000001"
              ]
            },
            "name": {
              "type": "string",
              "enum": [
                "AMS-III.F. | BOLD Carbon (CH₄) - SSC",
                "AMS-III.F. | BOLD Recycling Credit"
              ],
              "title": "Methodology Name",
              "description": "Full official name of the methodology",
              "examples": [
                "AMS-III.F. | BOLD Carbon (CH₄) - SSC",
                "AMS-III.F. | BOLD Recycling Credit"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
              "title": "Methodology Version",
              "description": "Version of the methodology",
              "examples": [
                "0.1.0",
                "1.0.0",
                "2.1.3"
              ]
            },
            "external_url": {
              "type": "string",
              "format": "uri",
              "title": "Methodology External URL",
              "description": "URL to view the methodology on Carrot Registry",
              "examples": [
                "https://registry.example.com/",
                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
              ]
            },
            "ipfs_uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
              "title": "Methodology IPFS URI",
              "description": "IPFS URI of the version-specific Methodology JSON document; that document links to its PDF",
              "examples": [
                "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              ]
            }
          },
          "required": [
            "external_id",
            "name",
            "version",
            "external_url",
            "ipfs_uri"
          ],
          "additionalProperties": false,
          "title": "Methodology Reference",
          "description": "Reference to the exact version of a Methodology JSON document used by this record"
        },
        "mass_id": {
          "type": "object",
          "properties": {
            "external_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "title": "External ID",
              "description": "UUID v4 identifier linking this IPFS record to its counterpart in the Carrot platform and other consuming systems",
              "examples": [
                "00000000-0000-4000-8000-000000000001"
              ]
            },
            "external_url": {
              "type": "string",
              "format": "uri",
              "title": "External URL",
              "description": "URL pointing to external resources",
              "examples": [
                "https://registry.example.com/",
                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
              ]
            },
            "ipfs_uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
              "title": "IPFS URI",
              "description": "InterPlanetary File System URI pointing to distributed content",
              "examples": [
                "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              ]
            },
            "chain_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "title": "Chain ID",
              "description": "Positive identifier of the network that deployed this token; resolve the current metadata on this chain, while ipfs_uri retains the referenced snapshot",
              "examples": [
                137,
                80002
              ]
            },
            "smart_contract_address": {
              "type": "string",
              "pattern": "^0x[a-f0-9]{40}$",
              "title": "Smart Contract Address",
              "description": "Ethereum-compatible address of the smart contract that mints and manages this token",
              "examples": [
                "0x1234567890abcdef1234567890abcdef12345678"
              ]
            },
            "token_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^\\d+$",
              "title": "Token ID",
              "description": "Unique token identifier for this NFT within the smart contract",
              "examples": [
                "456789",
                "1000000"
              ]
            }
          },
          "required": [
            "external_id",
            "external_url",
            "ipfs_uri",
            "chain_id",
            "smart_contract_address",
            "token_id"
          ],
          "additionalProperties": false,
          "title": "MassID Reference",
          "description": "Reference to a MassID record"
        },
        "gas_id": {
          "type": "object",
          "properties": {
            "external_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
              "title": "External ID",
              "description": "UUID v4 identifier linking this IPFS record to its counterpart in the Carrot platform and other consuming systems",
              "examples": [
                "00000000-0000-4000-8000-000000000001"
              ]
            },
            "external_url": {
