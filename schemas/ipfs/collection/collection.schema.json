{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "title": "JSON Schema URI",
      "description": "Versioned URL of the JSON Schema used to validate this record; it must identify the same artifact as schema.ipfs_uri and schema.hash"
    },
    "schema": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Schema Hash",
          "description": "SHA-256 digest of the canonical JSON Schema object identified by this version and IPFS URI",
          "examples": [
            "87f633634cc4b02f628685651f0a29b7bfa22a0bd841f725c6772dd00a58d489"
          ]
        },
        "type": {
          "type": "string",
          "const": "Collection",
          "title": "Collection Schema Type",
          "description": "Discriminator value identifying this record as a Collection grouping of credits and receipts"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
          "title": "Schema Version",
          "description": "Version of the schema, using semantic versioning",
          "examples": [
            "0.1.0",
            "1.0.0",
            "2.1.3"
          ]
        },
        "ipfs_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Schema IPFS URI",
          "description": "IPFS URI of the exact pinned JSON Schema artifact whose version and hash are recorded alongside it",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        }
      },
      "required": [
        "hash",
        "type",
        "version",
        "ipfs_uri"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "title": "Created At",
      "description": "ISO 8601 timestamp when this metadata document was created; it is not the date of the underlying event or methodology publication",
      "examples": [
        "2024-12-05T11:02:47.000Z"
      ]
    },
    "external_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "title": "External ID",
      "description": "UUID v4 identifier linking this IPFS record to its counterpart in the Carrot platform and other consuming systems",
      "examples": [
        "00000000-0000-4000-8000-000000000001"
      ]
    },
    "external_url": {
      "type": "string",
      "format": "uri",
      "title": "External URL",
      "description": "URL pointing to external resources",
      "examples": [
        "https://registry.example.com/",
        "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
      ]
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "previous_uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Exact Predecessor URI",
              "description": "Literal predecessor pointer, preserved without normalization; legacy invalid or stub strings are allowed and are not asserted to be valid CIDs",
              "examples": [
                "ipfs://random-uri"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ],
              "title": "Overall Revision Reason",
              "description": "Approved summary reused verbatim as the token update event reason and compared during readback; no inferred or fabricated explanation",
              "examples": [
                "Use the approved image document.",
                "Correct the metadata references."
              ]
            },
            "comparison": {
              "type": "string",
              "const": "verified",
              "title": "Verified Predecessor Comparison",
              "description": "Producer asserts actual predecessor/candidate comparison; schema validity alone does not prove the comparison"
            },
            "changes": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^(?!\\/revision(?:\\/|$))\\/(?:[^~]|~[01])*$",
                    "title": "Changed Field Path",
                    "description": "RFC 6901 JSON Pointer excluding the root revision subtree; removals resolve against the predecessor. Array indices do not establish item identity",
                    "examples": [
                      "/image",
                      "/data/a~1b/m~0n",
                      "/attributes"
                    ]
                  },
                  "categories": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "schema_migration",
                        "image_update",
                        "metadata_correction",
                        "reference_update",
                        "rollback"
                      ],
                      "title": "Revision Category",
                      "description": "Explanation category for an individual field change; it does not authorize scientific fact changes without approved provenance",
                      "examples": [
                        "schema_migration",
                        "reference_update"
                      ]
                    },
                    "title": "Field Change Categories",
                    "description": "One or more distinct approved categories explaining this field",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "image_update",
                        "reference_update"
                      ]
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\uD800-\\uDFFF]*$"
                      }
                    ],
                    "title": "Revision Reason",
                    "description": "Approved human explanation, at most 500 UTF-16 units with well-formed Unicode; preserved verbatim without trimming or normalization",
                    "examples": [
                      "Use the approved image document.",
                      "Correct the metadata references."
                    ]
                  },
                  "references": {
                    "title": "Field Change Supporting References",
                    "description": "Distinct public evidence references when real supporting information exists; omit rather than fabricate evidence",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "https://example.com/evidence/correction"
                      ]
                    ],
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
                          "title": "IPFS URI",
                          "description": "InterPlanetary File System URI pointing to distributed content",
                          "examples": [
                            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
                          ]
                        },
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "maxLength": 4096,
                              "format": "uri",
                              "title": "External URL",
                              "description": "URL pointing to external resources",
                              "examples": [
                                "https://registry.example.com/",
                                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/[^/?#\\s]+(?:[/?#][\\s\\S]*)?$"
                            }
                          ]
                        }
                      ],
                      "title": "Revision Supporting Reference",
                      "description": "Public supporting evidence actually available for this field change, expressed as a valid IPFS document URI or HTTP(S) URL",
                      "examples": [
                        "https://example.com/evidence/correction"
                      ]
                    }
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "add",
                      "replace",
                      "remove"
                    ],
                    "title": "Verified Revision Operation",
                    "description": "Operation derived from actual predecessor and candidate comparison: absent to present, changed existing value, or present to absent",
                    "examples": [
                      "replace",
                      "remove"
                    ]
                  }
                },
                "required": [
                  "path",
                  "categories",
                  "reason",
                  "operation"
                ],
                "additionalProperties": false,
                "title": "Verified Revision Change",
                "description": "Field-level explanation with an operation asserted from actual before/after comparison; readers may independently verify it"
              },
              "title": "Verified Field Changes",
              "description": "Distinct field paths derived from before/after documents excluding revision itself; all operations are required and no entries are truncated"
            }
          },
          "required": [
            "previous_uri",
            "reason",
            "comparison",
            "changes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "previous_uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Exact Predecessor URI",
              "description": "Literal predecessor pointer, preserved without normalization; legacy invalid or stub strings are allowed and are not asserted to be valid CIDs",
              "examples": [
                "ipfs://random-uri"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ],
              "title": "Overall Revision Reason",
              "description": "Approved summary reused verbatim as the token update event reason and compared during readback; no inferred or fabricated explanation",
              "examples": [
                "Use the approved image document.",
                "Correct the metadata references."
              ]
            },
            "comparison": {
              "type": "string",
              "const": "unavailable",
              "title": "Unavailable Predecessor Comparison",
              "description": "Predecessor cannot be compared, including a legacy stub; changes retain declared explanations and must not contain operations"
            },
            "changes": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^(?!\\/revision(?:\\/|$))\\/(?:[^~]|~[01])*$",
                    "title": "Changed Field Path",
                    "description": "RFC 6901 JSON Pointer excluding the root revision subtree; removals resolve against the predecessor. Array indices do not establish item identity",
                    "examples": [
                      "/image",
                      "/data/a~1b/m~0n",
                      "/attributes"
                    ]
                  },
                  "categories": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "schema_migration",
                        "image_update",
                        "metadata_correction",
                        "reference_update",
                        "rollback"
                      ],
                      "title": "Revision Category",
                      "description": "Explanation category for an individual field change; it does not authorize scientific fact changes without approved provenance",
                      "examples": [
                        "schema_migration",
                        "reference_update"
                      ]
                    },
                    "title": "Field Change Categories",
                    "description": "One or more distinct approved categories explaining this field",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "image_update",
                        "reference_update"
                      ]
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\uD800-\\uDFFF]*$"
                      }
                    ],
                    "title": "Revision Reason",
                    "description": "Approved human explanation, at most 500 UTF-16 units with well-formed Unicode; preserved verbatim without trimming or normalization",
                    "examples": [
                      "Use the approved image document.",
                      "Correct the metadata references."
                    ]
                  },
                  "references": {
                    "title": "Field Change Supporting References",
                    "description": "Distinct public evidence references when real supporting information exists; omit rather than fabricate evidence",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "https://example.com/evidence/correction"
                      ]
                    ],
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
                          "title": "IPFS URI",
                          "description": "InterPlanetary File System URI pointing to distributed content",
                          "examples": [
                            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
                          ]
                        },
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "maxLength": 4096,
                              "format": "uri",
                              "title": "External URL",
                              "description": "URL pointing to external resources",
                              "examples": [
                                "https://registry.example.com/",
                                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/[^/?#\\s]+(?:[/?#][\\s\\S]*)?$"
                            }
                          ]
                        }
                      ],
                      "title": "Revision Supporting Reference",
                      "description": "Public supporting evidence actually available for this field change, expressed as a valid IPFS document URI or HTTP(S) URL",
                      "examples": [
                        "https://example.com/evidence/correction"
                      ]
                    }
                  }
                },
                "required": [
                  "path",
                  "categories",
                  "reason"
                ],
                "additionalProperties": false,
                "title": "Declared Revision Change",
                "description": "Field-level explanation without an operation when predecessor comparison is unavailable; no copied old or new values"
              },
              "title": "Declared Field Changes",
              "description": "Distinct declared field paths and approved explanations without an invented operation or old value"
            }
          },
          "required": [
            "previous_uri",
            "reason",
            "comparison",
            "changes"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Metadata Revision",
      "description": "Common revision block required by new update publication paths and absent on initial publication; producer context and independent readback establish publication and comparison facts"
    },
    "viewer_reference": {
      "type": "object",
      "properties": {
        "ipfs_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Viewer IPFS URI",
          "description": "IPFS URI of the metadata viewer dApp build",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        }
      },
      "required": [
        "ipfs_uri"
      ],
      "additionalProperties": false,
      "title": "Metadata Viewer Reference",
      "description": "Immutable reference to the metadata viewer dApp build. The IPFS CID itself is the integrity proof: tampered content resolves to a different CID"
    },
    "environment": {
      "type": "object",
      "properties": {
        "blockchain_network": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet"
          ],
          "title": "Blockchain Network",
          "description": "Blockchain network where this record is deployed"
        },
        "deployment": {
          "type": "string",
          "enum": [
            "production",
            "development",
            "testing"
          ],
          "title": "Deployment Environment",
          "description": "System environment where this record was generated"
        },
        "data_set_name": {
          "type": "string",
          "enum": [
            "TEST",
            "PROD"
          ],
          "title": "Data Set Name",
          "description": "Name of the data set for this record"
        }
      },
      "required": [
        "blockchain_network",
        "deployment",
        "data_set_name"
      ],
      "additionalProperties": false,
      "title": "Record Environment",
      "description": "Environment information for the record"
    },
    "data": {
      "title": "Custom Data",
      "description": "Collection-specific data payload",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "title": "Collection Name",
      "description": "Human-readable display name for the environmental credit collection",
      "examples": [
        "Example Collection One",
        "Example Collection Two"
      ]
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9-]+$",
      "title": "Collection Slug",
      "description": "URL-friendly identifier for an environmental credit collection, used in URIs and API references",
      "examples": [
        "example-collection-one",
        "example-collection-two"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
      "title": "Collection Image",
      "description": "IPFS URI pointing to the collection's visual representation",
      "examples": [
        "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 1000,
      "title": "Collection Description",
      "description": "Human-readable purpose and context of this collection grouping; this document is distinct from its image asset",
      "examples": [
        "Illustrative collection grouping credit purchases and retirements for an example campaign. The collection document describes the grouping and points to a separate image asset; its URI is what receipt collection references cite."
      ]
    }
  },
  "required": [
    "$schema",
    "schema",
    "created_at",
    "external_id",
    "external_url",
    "name",
    "slug",
    "image",
    "description"
  ],
  "additionalProperties": false,
  "title": "Collection IPFS Record",
  "description": "Collection metadata stored in IPFS, extending the base schema with collection-specific fields used to group and organize credit purchases and retirements in Carrot's ecosystem",
  "$id": "https://raw.githubusercontent.com/carrot-foundation/schemas/refs/tags/v6.0.0/schemas/ipfs/collection/collection.schema.json",
  "version": "6.0.0"
}
