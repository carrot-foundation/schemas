{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "title": "JSON Schema URI",
      "description": "Versioned URL of the JSON Schema used to validate this record; it must identify the same artifact as schema.ipfs_uri and schema.hash"
    },
    "schema": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "title": "Schema Hash",
          "description": "SHA-256 digest of the canonical JSON Schema object identified by this version and IPFS URI",
          "examples": [
            "87f633634cc4b02f628685651f0a29b7bfa22a0bd841f725c6772dd00a58d489"
          ]
        },
        "type": {
          "type": "string",
          "const": "Methodology",
          "title": "Methodology Schema Type",
          "description": "Discriminator value identifying this record as a Methodology impact-measurement definition"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
          "title": "Schema Version",
          "description": "Version of the schema, using semantic versioning",
          "examples": [
            "0.1.0",
            "1.0.0",
            "2.1.3"
          ]
        },
        "ipfs_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Schema IPFS URI",
          "description": "IPFS URI of the exact pinned JSON Schema artifact whose version and hash are recorded alongside it",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        }
      },
      "required": [
        "hash",
        "type",
        "version",
        "ipfs_uri"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "title": "Created At",
      "description": "ISO 8601 timestamp when this metadata document was created; it is not the date of the underlying event or methodology publication",
      "examples": [
        "2024-12-05T11:02:47.000Z"
      ]
    },
    "external_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
      "title": "External ID",
      "description": "UUID v4 identifier linking this IPFS record to its counterpart in the Carrot platform and other consuming systems",
      "examples": [
        "00000000-0000-4000-8000-000000000001"
      ]
    },
    "external_url": {
      "type": "string",
      "format": "uri",
      "title": "External URL",
      "description": "URL pointing to external resources",
      "examples": [
        "https://registry.example.com/",
        "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
      ]
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "previous_uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Exact Predecessor URI",
              "description": "Literal predecessor pointer, preserved without normalization; legacy invalid or stub strings are allowed and are not asserted to be valid CIDs",
              "examples": [
                "ipfs://random-uri"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ],
              "title": "Overall Revision Reason",
              "description": "Approved summary reused verbatim as the token update event reason and compared during readback; no inferred or fabricated explanation",
              "examples": [
                "Use the approved image document.",
                "Correct the metadata references."
              ]
            },
            "comparison": {
              "type": "string",
              "const": "verified",
              "title": "Verified Predecessor Comparison",
              "description": "Producer asserts actual predecessor/candidate comparison; schema validity alone does not prove the comparison"
            },
            "changes": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^(?!\\/revision(?:\\/|$))\\/(?:[^~]|~[01])*$",
                    "title": "Changed Field Path",
                    "description": "RFC 6901 JSON Pointer excluding the root revision subtree; removals resolve against the predecessor. Array indices do not establish item identity",
                    "examples": [
                      "/image",
                      "/data/a~1b/m~0n",
                      "/attributes"
                    ]
                  },
                  "categories": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "schema_migration",
                        "image_update",
                        "metadata_correction",
                        "reference_update",
                        "rollback"
                      ],
                      "title": "Revision Category",
                      "description": "Explanation category for an individual field change; it does not authorize scientific fact changes without approved provenance",
                      "examples": [
                        "schema_migration",
                        "reference_update"
                      ]
                    },
                    "title": "Field Change Categories",
                    "description": "One or more distinct approved categories explaining this field",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "image_update",
                        "reference_update"
                      ]
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\uD800-\\uDFFF]*$"
                      }
                    ],
                    "title": "Revision Reason",
                    "description": "Approved human explanation, at most 500 UTF-16 units with well-formed Unicode; preserved verbatim without trimming or normalization",
                    "examples": [
                      "Use the approved image document.",
                      "Correct the metadata references."
                    ]
                  },
                  "references": {
                    "title": "Field Change Supporting References",
                    "description": "Distinct public evidence references when real supporting information exists; omit rather than fabricate evidence",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "https://example.com/evidence/correction"
                      ]
                    ],
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
                          "title": "IPFS URI",
                          "description": "InterPlanetary File System URI pointing to distributed content",
                          "examples": [
                            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
                          ]
                        },
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "maxLength": 4096,
                              "format": "uri",
                              "title": "External URL",
                              "description": "URL pointing to external resources",
                              "examples": [
                                "https://registry.example.com/",
                                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/[^/?#\\s]+(?:[/?#][\\s\\S]*)?$"
                            }
                          ]
                        }
                      ],
                      "title": "Revision Supporting Reference",
                      "description": "Public supporting evidence actually available for this field change, expressed as a valid IPFS document URI or HTTP(S) URL",
                      "examples": [
                        "https://example.com/evidence/correction"
                      ]
                    }
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "add",
                      "replace",
                      "remove"
                    ],
                    "title": "Verified Revision Operation",
                    "description": "Operation derived from actual predecessor and candidate comparison: absent to present, changed existing value, or present to absent",
                    "examples": [
                      "replace",
                      "remove"
                    ]
                  }
                },
                "required": [
                  "path",
                  "categories",
                  "reason",
                  "operation"
                ],
                "additionalProperties": false,
                "title": "Verified Revision Change",
                "description": "Field-level explanation with an operation asserted from actual before/after comparison; readers may independently verify it"
              },
              "title": "Verified Field Changes",
              "description": "Distinct field paths derived from before/after documents excluding revision itself; all operations are required and no entries are truncated"
            }
          },
          "required": [
            "previous_uri",
            "reason",
            "comparison",
            "changes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "previous_uri": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "title": "Exact Predecessor URI",
              "description": "Literal predecessor pointer, preserved without normalization; legacy invalid or stub strings are allowed and are not asserted to be valid CIDs",
              "examples": [
                "ipfs://random-uri"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "allOf": [
                {
                  "pattern": "\\S"
                },
                {
                  "pattern": "^[^\\uD800-\\uDFFF]*$"
                }
              ],
              "title": "Overall Revision Reason",
              "description": "Approved summary reused verbatim as the token update event reason and compared during readback; no inferred or fabricated explanation",
              "examples": [
                "Use the approved image document.",
                "Correct the metadata references."
              ]
            },
            "comparison": {
              "type": "string",
              "const": "unavailable",
              "title": "Unavailable Predecessor Comparison",
              "description": "Predecessor cannot be compared, including a legacy stub; changes retain declared explanations and must not contain operations"
            },
            "changes": {
              "minItems": 1,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^(?!\\/revision(?:\\/|$))\\/(?:[^~]|~[01])*$",
                    "title": "Changed Field Path",
                    "description": "RFC 6901 JSON Pointer excluding the root revision subtree; removals resolve against the predecessor. Array indices do not establish item identity",
                    "examples": [
                      "/image",
                      "/data/a~1b/m~0n",
                      "/attributes"
                    ]
                  },
                  "categories": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "schema_migration",
                        "image_update",
                        "metadata_correction",
                        "reference_update",
                        "rollback"
                      ],
                      "title": "Revision Category",
                      "description": "Explanation category for an individual field change; it does not authorize scientific fact changes without approved provenance",
                      "examples": [
                        "schema_migration",
                        "reference_update"
                      ]
                    },
                    "title": "Field Change Categories",
                    "description": "One or more distinct approved categories explaining this field",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "image_update",
                        "reference_update"
                      ]
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "allOf": [
                      {
                        "pattern": "\\S"
                      },
                      {
                        "pattern": "^[^\\uD800-\\uDFFF]*$"
                      }
                    ],
                    "title": "Revision Reason",
                    "description": "Approved human explanation, at most 500 UTF-16 units with well-formed Unicode; preserved verbatim without trimming or normalization",
                    "examples": [
                      "Use the approved image document.",
                      "Correct the metadata references."
                    ]
                  },
                  "references": {
                    "title": "Field Change Supporting References",
                    "description": "Distinct public evidence references when real supporting information exists; omit rather than fabricate evidence",
                    "uniqueItems": true,
                    "examples": [
                      [
                        "https://example.com/evidence/correction"
                      ]
                    ],
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096,
                          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
                          "title": "IPFS URI",
                          "description": "InterPlanetary File System URI pointing to distributed content",
                          "examples": [
                            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
                          ]
                        },
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "maxLength": 4096,
                              "format": "uri",
                              "title": "External URL",
                              "description": "URL pointing to external resources",
                              "examples": [
                                "https://registry.example.com/",
                                "https://registry.example.com/document/00000000-0000-4000-8000-100000000009"
                              ]
                            },
                            {
                              "type": "string",
                              "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/[^/?#\\s]+(?:[/?#][\\s\\S]*)?$"
                            }
                          ]
                        }
                      ],
                      "title": "Revision Supporting Reference",
                      "description": "Public supporting evidence actually available for this field change, expressed as a valid IPFS document URI or HTTP(S) URL",
                      "examples": [
                        "https://example.com/evidence/correction"
                      ]
                    }
                  }
                },
                "required": [
                  "path",
                  "categories",
                  "reason"
                ],
                "additionalProperties": false,
                "title": "Declared Revision Change",
                "description": "Field-level explanation without an operation when predecessor comparison is unavailable; no copied old or new values"
              },
              "title": "Declared Field Changes",
              "description": "Distinct declared field paths and approved explanations without an invented operation or old value"
            }
          },
          "required": [
            "previous_uri",
            "reason",
            "comparison",
            "changes"
          ],
          "additionalProperties": false
        }
      ],
      "title": "Metadata Revision",
      "description": "Common revision block required by new update publication paths and absent on initial publication; producer context and independent readback establish publication and comparison facts"
    },
    "viewer_reference": {
      "type": "object",
      "properties": {
        "ipfs_uri": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Viewer IPFS URI",
          "description": "IPFS URI of the metadata viewer dApp build",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        }
      },
      "required": [
        "ipfs_uri"
      ],
      "additionalProperties": false,
      "title": "Metadata Viewer Reference",
      "description": "Immutable reference to the metadata viewer dApp build. The IPFS CID itself is the integrity proof: tampered content resolves to a different CID"
    },
    "environment": {
      "type": "object",
      "properties": {
        "blockchain_network": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet"
          ],
          "title": "Blockchain Network",
          "description": "Blockchain network where this record is deployed"
        },
        "deployment": {
          "type": "string",
          "enum": [
            "production",
            "development",
            "testing"
          ],
          "title": "Deployment Environment",
          "description": "System environment where this record was generated"
        },
        "data_set_name": {
          "type": "string",
          "enum": [
            "TEST",
            "PROD"
          ],
          "title": "Data Set Name",
          "description": "Name of the data set for this record"
        }
      },
      "required": [
        "blockchain_network",
        "deployment",
        "data_set_name"
      ],
      "additionalProperties": false,
      "title": "Record Environment",
      "description": "Environment information for the record"
    },
    "data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "AMS-III.F. | BOLD Carbon (CH₄) - SSC",
            "AMS-III.F. | BOLD Recycling Credit"
          ],
          "title": "Methodology Name",
          "description": "Full official name of the methodology",
          "examples": [
            "AMS-III.F. | BOLD Carbon (CH₄) - SSC",
            "AMS-III.F. | BOLD Recycling Credit"
          ]
        },
        "short_name": {
          "type": "string",
          "enum": [
            "BOLD Carbon (CH₄)",
            "BOLD Recycling"
          ],
          "title": "Methodology Short Name",
          "description": "Abbreviated/short name of the methodology used for UI display and references",
          "examples": [
            "BOLD Carbon (CH₄)",
            "BOLD Recycling"
          ]
        },
        "slug": {
          "type": "string",
          "enum": [
            "bold-recycling",
            "bold-carbon-ch4"
          ],
          "title": "Methodology Slug",
          "description": "URL-friendly identifier for the methodology",
          "examples": [
            "bold-recycling",
            "bold-carbon-ch4"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
          "title": "Methodology Version",
          "description": "Operational Methodology entity revision; independent of manifest format, framework, application and executed processor versions",
          "examples": [
            "0.1.0",
            "1.0.0",
            "2.1.3"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 50,
          "maxLength": 2000,
          "title": "Methodology Description",
          "description": "Comprehensive methodology description including purpose, scope, and implementation approach"
        },
        "revision_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "title": "Revision Date",
          "description": "Official ISO 8601 revision date of the methodology version represented by this document; source it from the versioned publication, not database creation time",
          "examples": [
            "2024-12-05"
          ]
        },
        "publication_date": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "title": "Publication Date",
          "description": "ISO 8601 date of the first official publication of this methodology family, independent of the represented version; source it from official publication history",
          "examples": [
            "2024-12-05"
          ]
        },
        "methodology_pdf": {
          "type": "string",
          "minLength": 1,
          "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
          "title": "Methodology PDF",
          "description": "IPFS URI pointing to the complete methodology PDF document",
          "examples": [
            "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
            "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
          ]
        },
        "rules_manifest": {
          "type": "object",
          "properties": {
            "ipfs_uri": {
              "type": "string",
              "minLength": 1,
              "pattern": "^ipfs:\\/\\/(?:Qm[1-9A-HJ-NP-Za-km-z]{44}|[bB][a-z2-7]{58,}|[zZ][1-9A-HJ-NP-Za-km-z]{48,})(?:\\/[^\\s]*)?$",
              "title": "Rules Manifest IPFS URI",
              "description": "Complete immutable IPFS locator of the original received methodology-rules manifest bytes, including any file path",
              "examples": [
                "ipfs://bafybeigdyrztvzl5cceubvaxob7iqh6f3f7s36c74ojav2xsz2uib2g3vm",
                "ipfs://bafybeihdwdcefgh4dqkjv67uzcmw7ojee6xedzdetojuzjevtenxquvyku"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "title": "Rules Manifest SHA-256",
              "description": "SHA-256 of the original received manifest bytes, not a regeneration or reformatted projection",
              "examples": [
                "87f633634cc4b02f628685651f0a29b7bfa22a0bd841f725c6772dd00a58d489"
              ]
            },
            "source_commit": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{40}$",
              "title": "Rules Manifest Source Commit",
              "description": "Full sourceCommit declared by the immutable manifest; independent of the processor source-code version",
              "examples": [
                "0000000000000000000000000000000000000000"
              ]
            },
            "framework": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-z0-9-]+$",
                  "title": "Manifest Selection Slug",
                  "description": "Exact framework or application key in the frozen manifest",
                  "examples": [
                    "mass-id-123",
                    "recycled-plastic",
                    "organic-waste"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.-]+)?(\\+[a-zA-Z0-9.-]+)?$",
                  "title": "Manifest Selection Version",
                  "description": "Exact version of the selected framework or application in the frozen manifest; independent of operational Methodology and processor versions",
                  "examples": [
